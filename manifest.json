{
  "schema_version": 2,
  "general_direct": {
    "id": "loyalsoldier-direct",
    "urls": [
      "https://testingcf.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt",
      "https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/direct.txt"
    ],
    "min_count": 100000,
    "max_count": 130000,
    "max_new_per_run": 5000,
    "exclude": []
  },
  "services": {
    "xiaohongshu": {
      "display_name": "小红书／RedNote",
      "source_note": "上游：MetaCubeX geosite:xiaohongshu；本地增删：manifest.json",
      "urls": [
        "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/xiaohongshu.yaml",
        "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/xiaohongshu.yaml"
      ],
      "min_count": 8,
      "max_count": 200,
      "canary": "sns-webpic-qc.xhscdn.com",
      "include": [
        "cdnxhs.com",
        "fengkongcloud.com",
        "redbascket.com",
        "rednote.life",
        "xhs.cn",
        "xhscdn.cn",
        "xhsdns.com",
        "xhsdns.net",
        "xhslink.cn",
        "xhsos.com",
        "xhsredcdn.com",
        "xhssys.cn",
        "xhssys.com",
        "xhssys.net",
        "xhsurl.cn",
        "xhsurl.com",
        "xiaohongshu-mycdn.com",
        "xiaohongshu.cn",
        "xiaohongshu.net",
        "xingin.net",
        "zztfly.com"
      ],
      "exclude": [
        "rednote.com.my"
      ]
    },
    "douyin": {
      "display_name": "抖音",
      "source_note": "上游：MetaCubeX geosite:douyin；本地增删：manifest.json",
      "urls": [
        "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/douyin.yaml",
        "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/douyin.yaml"
      ],
      "min_count": 50,
      "max_count": 300,
      "canary": "www.douyin.com",
      "include": [],
      "exclude": []
    }
  },
  "forced_proxy": {
    "note": "命中这些后缀（含全部子域）的域名一律交给代理支：mosdns转mini的fake DNS、Surge走Proxy组；并从全部直连产物中剔除。小红书接口服务器对家庭宽带公网IP限速，接口经mini的代理出口访问；图片视频CDN域名（xhscdn.com）不在此列，照旧直连。",
    "domains": [
      "xiaohongshu.com"
    ],
    "canary": "www.xiaohongshu.com"
  },
  "blocked": {
    "note": "命中这些后缀（含全部子域）的域名一律拒绝解析：mosdns回NXDOMAIN、Surge走REJECT；并从全部直连与强制代理产物中剔除。用途：堵国内App的HTTPDNS自家接口，让它们退回系统DNS。腾讯HTTPDNS的119.29.29.88/90两个IP由路由器防火墙拒绝80/443，不进本管线（119.29.29.29是mosdns兜底上游，不得连带）。",
    "domains": [
      "gslb.xiaohongshu.com",
      "mediacloud.xiaohongshu.com"
    ],
    "canary": "gslb.xiaohongshu.com"
  },
  "canaries": {
    "note": "消费方换完规则后的自检：proxy项必须解析出fake IP（证明代理支活着）。各服务的direct项见services.*.canary。",
    "proxy": [
      "chatgpt.com"
    ]
  },
  "distribution": {
    "repo": "LoneFireBlossom/home-network-rules",
    "branch": "main",
    "managed_rules_path": "generated/managed-direct-domains.txt",
    "surge_ruleset_path": "generated/surge-direct-services.list",
    "purge_base_url": "https://purge.jsdelivr.net/gh",
    "managed_proxy_rules_path": "generated/managed-proxy-domains.txt",
    "surge_proxy_ruleset_path": "generated/surge-proxy-services.list",
    "managed_blocked_rules_path": "generated/managed-blocked-domains.txt",
    "surge_blocked_ruleset_path": "generated/surge-blocked-services.list",
    "canaries_path": "generated/canaries.txt"
  }
}
